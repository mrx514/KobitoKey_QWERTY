#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <17 16>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };

        shifttab {
            bindings = <&kp LS(TAB)>;
            key-positions = <11 12>;
        };

        equal {
            bindings = <&kp LS(MINUS)>;
            key-positions = <8 9>;
        };

        exclamation {
            bindings = <&kp EXCL>;
            key-positions = <5 6>;
        };

        hatena {
            bindings = <&kp QUESTION>;
            key-positions = <29 28>;
        };

        double {
            bindings = <&kp LS(N2)>;
            key-positions = <8 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E             &kp R        &kp T    &kp Y     &kp U        &kp I      &kp O          &kp P
&kp A             &kp S         &kp D             &kp F        &kp G    &kp H     &kp J        &kp K      &lt 3 L        &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C             &kp V        &kp B    &kp N     &kp M        &kp COMMA  &kp DOT        &mt RIGHT_SHIFT SLASH
&kp LEFT_ALT      &kp LEFT_GUI  &kp LEFT_CONTROL  &lt 1 SPACE  &kp DEL  &kp BSPC  &lt 2 ENTER  &kp RSHFT  &kp RIGHT_ALT  &mt RIGHT_CONTROL SLASH
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3         &kp NUMBER_4     &kp N5  &kp NUMBER_6  &kp N7           &kp N8       &kp N9  &kp N0
&kp F1        &kp F2        &kp F3               &kp F4           &kp F5  &kp F6        &kp F7           &kp F8       &kp F9  &kp F10
&kp F11       &kp F12       &kp LA(LC(LS(TAB)))  &kp LA(LC(TAB))  &trans  &trans        &kp LS(LC(TAB))  &kp LC(TAB)  &trans  &trans
&trans        &trans        &trans               &trans           &trans  &trans        &trans           &trans       &trans  &trans
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&kp EXCL              &kp DOUBLE_QUOTES  &kp HASH           &kp DOLLAR        &kp PERCENT    &kp F1            &kp F2             &kp F3             &kp F4     &kp F5
&kp AT                &kp DOLLAR         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp AMPERSAND  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMI           &kp COLON  &kp EQUAL
&mt LEFT_SHIFT SLASH  &kp ASTRK          &kp PLUS           &kp MINUS         &kp PERIOD     &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LS(BACKSLASH)  &trans     &kp SLASH
&trans                &trans             &trans             &trans            &trans         &kp DEL           &trans             &trans             &trans     &kp NUBS
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans  &kp HOME        &kp UP_ARROW    &kp PAGE_UP      &trans  &mkp MB3  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &mkp MB3  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &kp END         &trans          &kp PAGE_DOWN    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans          &trans          &trans           &trans  &trans    &trans    &trans    &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &bt BT_CLR      &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
